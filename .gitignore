# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example

# Ambientes virtuais e caches Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Logs e arquivos gerados em execução
logs/*
!logs/.gitkeep
*.log

