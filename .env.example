# Nome de usuário do seu TikTok LIVE (sem o @)
TIKTOK_USERNAME=

# Modo TEST: true desativa o TikTok e permite simular comentários
TEST_MODE=false

# Servidor
HOST=127.0.0.1
PORT=8000